{
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/payos-webhook", "destination": "/api/payos-webhook" },
    { "source": "/api/(auth|children|admin|lessons|parent|transactions|leaderboard|payos|analytics|feedback)(.*)", "destination": "/api/router" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
